# Copy this file to .env and add your own key locally.
# Never commit real API keys to GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional map tiles. Leave empty to use OpenStreetMap.
# Set a CARTO Basemaps key (https://carto.com/basemaps/apikey/) to use CARTO Voyager instead.
# This is separate from OPENAI_API_KEY.
CARTO_API_KEY=

# Optional: POST internal notifications (not customer messages) to this URL instead of simulating them.
THREADLINE_NOTIFY_WEBHOOK_URL=
